# Copy to .env for local development. Every setting has a working default except the two
# marked REQUIRED IN DEPLOYMENT -- this file exists to show the shape.
# Full reference and the hardening checklist: docs/operations.md
#
# A KEYRING_-prefixed variable that matches no setting is a STARTUP ERROR, not a warning.
# A typo in KEYRING_MASTER_KEY would otherwise start the service with no vault.
#
# A test loads this file through the real Settings model, so a line here that names a
# setting that does not exist fails the build rather than a deployment.

# --- Identity and logging ---------------------------------------------------------
KEYRING_ENVIRONMENT=local
KEYRING_LOG_LEVEL=INFO
# json in deployment, console for readable local output
KEYRING_LOG_FORMAT=console
# Goes into every issued token's `iss` claim; consuming services pin it, so set every
# consumer's issuer to exactly this string. In deployment, keyring's public URL.
KEYRING_ISSUER=http://127.0.0.1:8001

# --- Serving ----------------------------------------------------------------------
# Loopback on purpose. This service belongs behind a TLS-terminating proxy.
KEYRING_HOST=127.0.0.1
KEYRING_PORT=8001

# --- Keys -------------------------------------------------------------------------
# REQUIRED IN DEPLOYMENT. base64 of 32 random bytes:
#   python -c 'import base64,os; print(base64.b64encode(os.urandom(32)).decode())'
# Lose it and every stored credential is unreadable. Leak it beside the files and they
# are all readable. Never commit it, never bake it into an image.
# KEYRING_MASTER_KEY=

# REQUIRED IN DEPLOYMENT. Break-glass: holds every permission, for when no owner can log
# in. Day-to-day administration should use an account with a role, so actions are
# attributable in the audit log.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# KEYRING_ADMIN_TOKEN=

# Generated on first start and persisted. A key that changed per restart would invalidate
# every token in flight at exactly the wrong moment.
KEYRING_SIGNING_KEY_PATH=var/keys/signing.pem

# --- Sessions and grants ----------------------------------------------------------
KEYRING_SESSION_TTL_SECONDS=1209600
KEYRING_SESSION_ABSOLUTE_TTL_SECONDS=7776000
KEYRING_MAX_SESSIONS_PER_ACCOUNT=20
KEYRING_INVITE_TTL_SECONDS=604800
# Short on purpose: a reset link is a password sitting in an inbox until it expires.
KEYRING_RESET_TTL_SECONDS=3600
KEYRING_LOCKOUT_THRESHOLD=10
KEYRING_LOCKOUT_SECONDS=900

# --- Service tokens ---------------------------------------------------------------
# Short, because a signed token cannot be revoked -- the expiry is the only revocation.
KEYRING_ACCESS_TOKEN_TTL_SECONDS=900

# One entry per service allowed to call /v1/internal, as ONE JSON document. The nested
# spelling KEYRING_SERVICE_TOKENS__NAME is an unknown variable, and a startup error.
#
# The name is the audience that service's user tokens must be minted for: keyring refuses
# a user token on /v1/internal unless its `aud` is exactly the calling service's name here.
# Name each service the way its callers mint -- media-tool, spotify-api, web-search-api,
# environments-api -- and use that same name as its audience in settings-api's grants.
#
# Each token at least 32 characters and unique to one service; both are startup errors.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# KEYRING_SERVICE_TOKENS='{"media-tool": "...", "spotify-api": "..."}'

# --- Rate limits (nested settings use a double underscore) -------------------------
KEYRING_RATE_LIMIT__LOGIN_ATTEMPTS=10
KEYRING_RATE_LIMIT__LOGIN_WINDOW_SECONDS=300
KEYRING_RATE_LIMIT__RESET_ATTEMPTS=5
KEYRING_RATE_LIMIT__RESET_WINDOW_SECONDS=3600
KEYRING_RATE_LIMIT__INVITE_ATTEMPTS=10
KEYRING_RATE_LIMIT__INVITE_WINDOW_SECONDS=3600

# --- Password hashing -------------------------------------------------------------
# RFC 9106's second recommended option. Slow on purpose -- do not "optimise" these.
# Argon2 needs 8 KiB per lane, and config refuses a combination that does not.
KEYRING_ARGON2__TIME_COST=3
KEYRING_ARGON2__MEMORY_COST_KIB=65536
KEYRING_ARGON2__PARALLELISM=4

# --- Storage ----------------------------------------------------------------------
# One SQLite file holding accounts, sessions, profiles, roles, the audit log and the
# encrypted credential material. Created 0600 with its -wal and -shm sidecars. Never
# inside a served directory. Back it up with `VACUUM INTO`, never `cp`: see
# docs/operations.md.
KEYRING_DATABASE_PATH=var/keyring.db

# --- Email (disabled by default) ---------------------------------------------------
# disabled  the operator delivers invite and reset tokens by hand. The default.
# file      writes messages to OUTBOX_DIR. For development -- so nobody logs a live link.
# smtp      sends for real. Gmail app password, Brevo, Resend, MailerSend, SES all work.
KEYRING_EMAIL__BACKEND=disabled
# KEYRING_EMAIL__HOST=smtp.example.com
# 587 with STARTTLS, or 465 with USE_IMPLICIT_TLS=true
# KEYRING_EMAIL__PORT=587
# KEYRING_EMAIL__USERNAME=
# KEYRING_EMAIL__PASSWORD=
# Credentials with neither TLS mode is a startup error, not a warning.
KEYRING_EMAIL__USE_STARTTLS=true
KEYRING_EMAIL__USE_IMPLICIT_TLS=false
# KEYRING_EMAIL__FROM_ADDRESS=keyring@example.com
KEYRING_EMAIL__FROM_NAME=keyring
# Where a token is redeemed. Left empty, messages carry the bare token to paste --
# which is honest for a service with no web UI.
# KEYRING_EMAIL__LINK_BASE_URL=https://keyring.example
KEYRING_EMAIL__OUTBOX_DIR=var/outbox
# Caps how often ONE ADDRESS is mailed, whoever asks. Stops password reset being used to
# flood somebody else's inbox.
KEYRING_EMAIL__MAX_MESSAGES_PER_ADDRESS_PER_WINDOW=5
KEYRING_EMAIL__WINDOW_SECONDS=3600

# --- OAuth ------------------------------------------------------------------------
# Must be mode 0600 -- it holds client secrets, and the loader refuses anything looser.
# KEYRING_OAUTH_PROVIDERS_PATH=var/providers.json
KEYRING_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/v1/oauth/callback
KEYRING_OAUTH_STATE_TTL_SECONDS=600
# Refresh this long before expiry, rather than after a request has already failed.
KEYRING_OAUTH_REFRESH_MARGIN_SECONDS=120

# --- Per-person settings (settings-api) -------------------------------------------
# Off unless both are set. Unset, every person gets the session lifetimes and cap
# above, which is today's behaviour exactly. Set, each login reads that person's
# `keyring` namespace: they may lower session_ttl_days, session_absolute_ttl_days and
# max_sessions, never raise them above this deployment. The token is this service's
# entry in settings-api's SETTINGS_API_SERVICES (32+ characters); the grant's
# audience_prefix must be `keyring` -- this service's token audience, not a caller's.
# Neither value is logged.
#
# KEYRING_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
# KEYRING_SETTINGS_API_TOKEN=

# --- Limits -----------------------------------------------------------------------
KEYRING_MAX_PROFILES_PER_ACCOUNT=20
KEYRING_MAX_CONNECTIONS_PER_PROFILE=50
